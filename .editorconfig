root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
max_line_length = 88

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.ipynb]
indent_size = unset
insert_final_newline = unset

# reStructuredText indentation depends on the directive
[*.rst]
indent_size = unset

# Two trailing spaces denote a hard line break in Markdown
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.bat]
end_of_line = crlf
